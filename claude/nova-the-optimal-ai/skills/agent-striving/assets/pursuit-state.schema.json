{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collaborative-dynamics.local/schemas/agent-striving-pursuit-state-v2.json",
  "title": "Agent Striving Portable Pursuit Handoff v2",
  "description": "A sparse custody envelope for a genuine host or state-owner boundary. It is not a host-goal prompt, project ledger, or universal pursuit model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "pursuit_ref",
    "authority_source",
    "current_direction",
    "disposition",
    "continuity",
    "updated_at"
  ],
  "properties": {
    "format": {
      "const": "cd-agent-striving-handoff/v2"
    },
    "pursuit_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "authority_source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "current_direction": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "disposition": {
      "enum": [
        "live",
        "resting",
        "released"
      ]
    },
    "current_state_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "foreground": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "settled": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "actual_state": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "likely_continuation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persistence",
        "persistence_receipt",
        "reactivation",
        "reactivation_cue",
        "lost_guarantee"
      ],
      "properties": {
        "persistence": {
          "enum": [
            "confirmed",
            "prepared",
            "unavailable"
          ]
        },
        "persistence_receipt": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "reactivation": {
          "enum": [
            "confirmed",
            "manual",
            "unavailable"
          ]
        },
        "reactivation_cue": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "lost_guarantee": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "persistence": {
                "const": "confirmed"
              }
            },
            "required": [
              "persistence"
            ]
          },
          "then": {
            "properties": {
              "persistence_receipt": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "not": {
                  "pattern": "^\\s*(?:[Nn][Oo][Nn][Ee]|[Nn]/?[Aa]|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Tt][Bb][Dd]|[Tt][Oo][Dd][Oo]|[Nn][Oo][Tt]\\s+[Aa][Pp][Pp][Ll][Ii][Cc][Aa][Bb][Ll][Ee])\\s*$"
                }
              }
            }
          },
          "else": {
            "properties": {
              "persistence_receipt": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reactivation": {
                "enum": [
                  "confirmed",
                  "manual"
                ]
              }
            },
            "required": [
              "reactivation"
            ]
          },
          "then": {
            "properties": {
              "reactivation_cue": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "not": {
                  "pattern": "^\\s*(?:[Nn][Oo][Nn][Ee]|[Nn]/?[Aa]|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Tt][Bb][Dd]|[Tt][Oo][Dd][Oo]|[Nn][Oo][Tt]\\s+[Aa][Pp][Pp][Ll][Ii][Cc][Aa][Bb][Ll][Ee])\\s*$"
                }
              }
            }
          },
          "else": {
            "properties": {
              "reactivation_cue": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "persistence": {
                    "const": "confirmed"
                  }
                },
                "required": [
                  "persistence"
                ]
              },
              {
                "properties": {
                  "reactivation": {
                    "enum": [
                      "confirmed",
                      "manual"
                    ]
                  }
                },
                "required": [
                  "reactivation"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "lost_guarantee": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "lost_guarantee": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "not": {
                  "pattern": "^\\s*(?:[Nn][Oo][Nn][Ee]|[Nn]/?[Aa]|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Tt][Bb][Dd]|[Tt][Oo][Dd][Oo]|[Nn][Oo][Tt]\\s+[Aa][Pp][Pp][Ll][Ii][Cc][Aa][Bb][Ll][Ee])\\s*$"
                }
              }
            }
          }
        }
      ]
    },
    "supersedes": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "description": "Supported RFC3339 profile: Gregorian year0001-9999, uppercase T/Z, second00-59 and bounded numeric offset components; real calendar validity checked by the Python validator. Leap seconds are not supported."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "released"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "foreground": {
            "not": {
              "required": [
                "likely_continuation"
              ]
            }
          }
        }
      }
    }
  ]
}
