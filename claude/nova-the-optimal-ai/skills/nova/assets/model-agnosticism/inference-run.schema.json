{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collaborative-dynamics.com/schemas/model-agnosticism/receipt-envelope-v2.json",
  "title": "Epistemic Model Agnosticism receipt envelope",
  "description": "Strict current engine 1.1.0 receipts plus structural acceptance of immutable historical v1 receipts. Historical acceptance does not upgrade the epistemic support of legacy calculations.",
  "oneOf": [
    {
      "$ref": "#/$defs/analyzeReceiptV2"
    },
    {
      "$ref": "#/$defs/validationReceiptV2"
    },
    {
      "$ref": "#/$defs/errorReceiptV2"
    },
    {
      "$ref": "#/$defs/historicalReceiptV1"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "shaId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stringArray": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
      }
    },
    "epistemicLane": {
      "enum": [
        "evidence_update",
        "assumption_stress_test"
      ]
    },
    "stepContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "interval_seconds",
        "description"
      ],
      "properties": {
        "kind": {
          "enum": [
            "event_step",
            "fixed_interval"
          ]
        },
        "interval_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "description": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "event_step"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "interval_seconds": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fixed_interval"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "interval_seconds": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "candidateSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis",
        "source_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "fixed_before_sequence",
            "data_dependent",
            "scenario_only"
          ]
        },
        "basis": {
          "$ref": "#/$defs/text"
        },
        "source_refs": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "stoppingContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis",
        "maximum_observations"
      ],
      "properties": {
        "status": {
          "enum": [
            "fixed_before_sequence",
            "data_dependent",
            "scenario_only"
          ]
        },
        "basis": {
          "$ref": "#/$defs/text"
        },
        "maximum_observations": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "parameterProvenance": {
      "$ref": "#/$defs/inputProvenance"
    },
    "matrixLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition",
        "emission"
      ],
      "properties": {
        "transition": {
          "const": "source_state_rows_target_state_columns/v1"
        },
        "emission": {
          "const": "state_rows_symbol_columns/v1"
        }
      }
    },
    "normalizationStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "absolute_tolerance",
        "vectors_checked",
        "vectors_adjusted",
        "negative_zero_values_canonicalized",
        "max_absolute_sum_error",
        "max_absolute_value_adjustment"
      ],
      "properties": {
        "policy": {
          "const": "l1_within_absolute_tolerance_canonical_positive_zero/v1"
        },
        "absolute_tolerance": {
          "const": 1E-09
        },
        "vectors_checked": {
          "type": "integer",
          "minimum": 1
        },
        "vectors_adjusted": {
          "type": "integer",
          "minimum": 0
        },
        "negative_zero_values_canonicalized": {
          "type": "integer",
          "minimum": 0
        },
        "max_absolute_sum_error": {
          "type": "number",
          "minimum": 0,
          "maximum": 1E-09
        },
        "max_absolute_value_adjustment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1E-09
        }
      }
    },
    "calibrationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration_id",
        "revision",
        "digest",
        "calibration_target_digest",
        "minimum_observations",
        "maximum_observations",
        "provenance"
      ],
      "properties": {
        "calibration_id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "calibration_target_digest": {
          "$ref": "#/$defs/digest"
        },
        "minimum_observations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maximum_observations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "provenance": {
          "$ref": "#/$defs/inputProvenance"
        }
      }
    },
    "priorSequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence_id",
        "revision",
        "digest"
      ],
      "properties": {
        "sequence_id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "numericRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "python_version",
        "float_radix",
        "float_mant_dig",
        "float_max_exp"
      ],
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "python_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "float_radix": {
          "type": "integer",
          "minimum": 2
        },
        "float_mant_dig": {
          "type": "integer",
          "minimum": 1
        },
        "float_max_exp": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "engineV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_id",
        "engine_version",
        "artifact_sha256",
        "numeric_kernel",
        "numeric_runtime",
        "matrix_layout",
        "normalization",
        "schema_versions"
      ],
      "properties": {
        "engine_id": {
          "const": "cd-model-agnosticism-trellis"
        },
        "engine_version": {
          "const": "1.1.0"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/digest"
        },
        "numeric_kernel": {
          "const": "logsumexp-forward_logsumexp-backward_log-viterbi"
        },
        "numeric_runtime": {
          "$ref": "#/$defs/numericRuntime"
        },
        "matrix_layout": {
          "$ref": "#/$defs/matrixLayout"
        },
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "absolute_tolerance"
          ],
          "properties": {
            "policy": {
              "const": "l1_within_absolute_tolerance_canonical_positive_zero/v1"
            },
            "absolute_tolerance": {
              "const": 1E-09
            }
          }
        },
        "schema_versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_set",
            "observation_sequence",
            "receipt_envelope"
          ],
          "properties": {
            "model_set": {
              "const": "cd-model-agnosticism-model-set/v2"
            },
            "observation_sequence": {
              "const": "cd-model-agnosticism-observation-sequence/v2"
            },
            "receipt_envelope": {
              "const": "cd-model-agnosticism-receipt-envelope/v2"
            }
          }
        }
      }
    },
    "resourceEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_units",
        "posterior_cells",
        "estimated_output_bytes",
        "limits"
      ],
      "properties": {
        "work_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "posterior_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500000
        },
        "estimated_output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 33554432
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_work_units",
            "max_posterior_cells",
            "max_output_bytes"
          ],
          "properties": {
            "max_work_units": {
              "const": 10000000
            },
            "max_posterior_cells": {
              "const": 500000
            },
            "max_output_bytes": {
              "const": 33554432
            }
          }
        }
      }
    },
    "posteriorVector": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "filteredRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence_index",
        "log_predictive_probability",
        "predictive_probability",
        "predictive_probability_underflow",
        "posterior",
        "posterior_log_probabilities",
        "posterior_finite_log_underflow_state_indices",
        "posterior_structural_zero_state_indices"
      ],
      "properties": {
        "sequence_index": {
          "type": "integer",
          "minimum": 0
        },
        "log_predictive_probability": {
          "type": [
            "number",
            "null"
          ],
          "maximum": 0
        },
        "predictive_probability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "predictive_probability_underflow": {
          "type": "boolean"
        },
        "posterior": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/posteriorVector"
            }
          ]
        },
        "posterior_log_probabilities": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/posteriorLogVector"
            }
          ]
        },
        "posterior_finite_log_underflow_state_indices": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stateIndexArray"
            }
          ]
        },
        "posterior_structural_zero_state_indices": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stateIndexArray"
            }
          ]
        }
      }
    },
    "smoothedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence_index",
        "posterior",
        "posterior_log_probabilities",
        "posterior_finite_log_underflow_state_indices",
        "posterior_structural_zero_state_indices",
        "uses_later_observations"
      ],
      "properties": {
        "sequence_index": {
          "type": "integer",
          "minimum": 0
        },
        "posterior": {
          "$ref": "#/$defs/posteriorVector"
        },
        "posterior_log_probabilities": {
          "$ref": "#/$defs/posteriorLogVector"
        },
        "posterior_finite_log_underflow_state_indices": {
          "$ref": "#/$defs/stateIndexArray"
        },
        "posterior_structural_zero_state_indices": {
          "$ref": "#/$defs/stateIndexArray"
        },
        "uses_later_observations": {
          "type": "boolean"
        }
      }
    },
    "absoluteFit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "assessment_basis",
        "calibration_truth_validated",
        "metric",
        "log_base",
        "unit",
        "threshold",
        "calibration_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "unassessed"
          ]
        },
        "reason": {
          "$ref": "#/$defs/stringArray"
        },
        "metric": {
          "const": "mean_predictive_surprisal"
        },
        "log_base": {
          "const": "e"
        },
        "unit": {
          "const": "nats_per_observation"
        },
        "threshold": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "calibration_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/calibrationRef"
            }
          ]
        },
        "assessment_basis": {
          "const": "declared_threshold_arithmetic"
        },
        "calibration_truth_validated": {
          "const": false
        }
      }
    },
    "viterbi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_indices",
        "log_joint_probability",
        "joint_probability",
        "joint_probability_underflow",
        "tie_breaking"
      ],
      "properties": {
        "state_indices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          }
        },
        "log_joint_probability": {
          "type": "number"
        },
        "joint_probability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "joint_probability_underflow": {
          "type": "boolean"
        },
        "tie_breaking": {
          "const": "lowest_predecessor_and_terminal_index_in_declared_state_order"
        }
      }
    },
    "fitSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "passing_model_ids",
        "failing_model_ids",
        "unassessed_model_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "all_pass",
            "mixed",
            "all_fail",
            "unassessed"
          ]
        },
        "passing_model_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "failing_model_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "unassessed_model_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "priorNormalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "absolute_tolerance",
        "sum_before",
        "adjusted"
      ],
      "properties": {
        "policy": {
          "const": "l1_within_absolute_tolerance_canonical_positive_zero/v1"
        },
        "absolute_tolerance": {
          "const": 1E-09
        },
        "sum_before": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "adjusted": {
          "type": "boolean"
        }
      }
    },
    "pairwiseRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator_model_id",
        "denominator_model_id",
        "status",
        "log_likelihood_ratio"
      ],
      "properties": {
        "numerator_model_id": {
          "$ref": "#/$defs/id"
        },
        "denominator_model_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "finite",
            "positive_infinity",
            "negative_infinity",
            "undefined_both_zero"
          ]
        },
        "log_likelihood_ratio": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "pairwiseReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "log_base",
        "orientation",
        "interpretation",
        "rows"
      ],
      "properties": {
        "status": {
          "enum": [
            "computed",
            "unsupported"
          ]
        },
        "reason": {
          "$ref": "#/$defs/stringArray"
        },
        "log_base": {
          "const": "e"
        },
        "orientation": {
          "const": "numerator_model_over_denominator_model"
        },
        "interpretation": {
          "enum": [
            "conditional_evidence",
            "diagnostic_only",
            "scenario_only",
            "none"
          ]
        },
        "rows": {
          "type": "array",
          "maxItems": 496,
          "items": {
            "$ref": "#/$defs/pairwiseRow"
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weights_status",
        "reason",
        "conditional_on_model_set",
        "effective_interpretation",
        "evidence_gate",
        "weight_interpretation",
        "linear_weights_complete",
        "fit_summary",
        "prior_normalization",
        "duplicate_screen",
        "relative_model_weights",
        "pairwise_log_likelihood_ratios"
      ],
      "properties": {
        "weights_status": {
          "enum": [
            "computed",
            "unsupported"
          ]
        },
        "reason": {
          "$ref": "#/$defs/stringArray"
        },
        "conditional_on_model_set": {
          "const": true
        },
        "effective_interpretation": {
          "enum": [
            "conditional_evidence_update",
            "diagnostic_only",
            "scenario_only"
          ]
        },
        "evidence_gate": {
          "$ref": "#/$defs/evidenceGate"
        },
        "weight_interpretation": {
          "enum": [
            "conditional_evidence_update",
            "diagnostic_only",
            "scenario_only",
            "none"
          ]
        },
        "linear_weights_complete": {
          "type": "boolean"
        },
        "fit_summary": {
          "$ref": "#/$defs/fitSummary"
        },
        "prior_normalization": {
          "$ref": "#/$defs/priorNormalization"
        },
        "duplicate_screen": {
          "$ref": "#/$defs/duplicateScreen"
        },
        "relative_model_weights": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/modelWeight"
          }
        },
        "pairwise_log_likelihood_ratios": {
          "$ref": "#/$defs/pairwiseReport"
        }
      }
    },
    "reframe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "required",
            "not_required",
            "unassessed"
          ]
        },
        "reasons": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "modelResultV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "comparison_unit_id",
        "model_version",
        "model_document_digest",
        "inference_model_digest",
        "predictive_kernel_digest",
        "observation_contract_digest",
        "state_order",
        "symbol_order",
        "matrix_layout",
        "normalization",
        "parameter_provenance",
        "prior_provenance",
        "inference_status",
        "log_sequence_likelihood",
        "sequence_likelihood",
        "sequence_likelihood_underflow",
        "mean_predictive_surprisal",
        "surprisal_log_base",
        "surprisal_unit",
        "absolute_fit",
        "filtered_state_posteriors"
      ],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/id"
        },
        "model_version": {
          "$ref": "#/$defs/id"
        },
        "model_document_digest": {
          "$ref": "#/$defs/digest"
        },
        "inference_model_digest": {
          "$ref": "#/$defs/digest"
        },
        "predictive_kernel_digest": {
          "$ref": "#/$defs/digest"
        },
        "observation_contract_digest": {
          "$ref": "#/$defs/digest"
        },
        "state_order": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "symbol_order": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "matrix_layout": {
          "$ref": "#/$defs/matrixLayout"
        },
        "normalization": {
          "$ref": "#/$defs/normalizationStats"
        },
        "parameter_provenance": {
          "$ref": "#/$defs/inputProvenance"
        },
        "inference_status": {
          "enum": [
            "completed",
            "zero_likelihood"
          ]
        },
        "log_sequence_likelihood": {
          "type": [
            "number",
            "null"
          ]
        },
        "sequence_likelihood": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "sequence_likelihood_underflow": {
          "type": "boolean"
        },
        "mean_predictive_surprisal": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "surprisal_log_base": {
          "const": "e"
        },
        "surprisal_unit": {
          "const": "nats_per_observation"
        },
        "absolute_fit": {
          "$ref": "#/$defs/absoluteFit"
        },
