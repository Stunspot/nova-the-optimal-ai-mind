    "modelWeight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "comparison_unit_id",
        "log_weight",
        "weight",
        "weight_status",
        "absolute_fit_status"
      ],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/id"
        },
        "comparison_unit_id": {
          "$ref": "#/$defs/id"
        },
        "log_weight": {
          "type": [
            "number",
            "null"
          ],
          "maximum": 0
        },
        "weight": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "weight_status": {
          "enum": [
            "finite",
            "underflow",
            "exact_zero"
          ]
        },
        "absolute_fit_status": {
          "enum": [
            "pass",
            "fail",
            "unassessed"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "weight_status": {
                "const": "finite"
              }
            },
            "required": [
              "weight_status"
            ]
          },
          "then": {
            "properties": {
              "log_weight": {
                "type": "number",
                "maximum": 0
              },
              "weight": {
                "type": "number",
                "maximum": 1,
                "exclusiveMinimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "weight_status": {
                "const": "underflow"
              }
            },
            "required": [
              "weight_status"
            ]
          },
          "then": {
            "properties": {
              "log_weight": {
                "type": "number",
                "maximum": 0
              },
              "weight": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "weight_status": {
                "const": "exact_zero"
              }
            },
            "required": [
              "weight_status"
            ]
          },
          "then": {
            "properties": {
              "log_weight": {
                "type": "null"
              },
              "weight": {
                "const": 0
              }
            }
          }
        }
      ]
    }
  }
