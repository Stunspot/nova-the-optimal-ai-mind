                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        },
        "identical_ordered_kernel_groups": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "predictive_kernel_digest",
              "model_ids"
            ],
            "properties": {
              "predictive_kernel_digest": {
                "$ref": "#/$defs/digest"
              },
              "model_ids": {
                "type": "array",
                "minItems": 2,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
