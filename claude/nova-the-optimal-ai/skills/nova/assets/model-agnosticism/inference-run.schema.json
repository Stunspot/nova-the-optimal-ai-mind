    "historicalReceiptV1": {
      "type": "object",
      "required": [
        "contract",
        "engine"
      ],
      "properties": {
        "contract": {
          "enum": [
            "cd-model-agnosticism-inference-run/v1",
            "cd-model-agnosticism-validation/v1",
            "cd-model-agnosticism-error/v1"
          ]
        },
        "engine": {
          "type": "object",
          "required": [
            "engine_id",
            "engine_version",
            "artifact_sha256"
          ],
          "properties": {
            "engine_id": {
              "const": "cd-model-agnosticism-trellis"
            },
            "engine_version": {
              "enum": [
                "1.0.0",
                "1.0.1"
              ]
            },
            "artifact_sha256": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "status": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "contract": {
                "const": "cd-model-agnosticism-inference-run/v1"
              }
            },
            "required": [
              "contract"
            ]
          },
          "then": {
            "required": [
              "run_id",
              "run_status",
              "inputs",
              "per_model",
              "comparison",
              "semantic_boundary"
            ],
            "properties": {
              "run_id": {
                "$ref": "#/$defs/shaId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "contract": {
                "const": "cd-model-agnosticism-validation/v1"
              }
            },
            "required": [
              "contract"
            ]
          },
          "then": {
            "required": [
              "validation_id",
              "inputs",
              "semantic_boundary"
            ],
            "properties": {
              "validation_id": {
                "$ref": "#/$defs/shaId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "contract": {
                "const": "cd-model-agnosticism-error/v1"
              }
            },
            "required": [
              "contract"
            ]
          },
          "then": {
            "required": [
              "error_id",
              "code",
              "message"
            ],
            "properties": {
              "error_id": {
                "$ref": "#/$defs/shaId"
              }
            }
          }
        }
      ]
    },
