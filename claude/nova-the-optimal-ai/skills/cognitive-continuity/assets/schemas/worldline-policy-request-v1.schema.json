{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collaborative-dynamics.com/schemas/cognitive-continuity/worldline-policy-request-v1.json",
  "title": "Governed Worldline policy request",
  "type": "object",
  "required": [
    "format",
    "scope",
    "authority",
    "expected_generation",
    "idempotency_key",
    "policy"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": "object",
      "required": [
        "selection_mode"
      ],
      "properties": {
        "selection_mode": {
          "enum": [
            "generic_explicit",
            "nova_ambient",
            "nova_explicit_authorized"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "grant_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "user",
        "agent"
      ],
      "properties": {
        "user": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "thread": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "expected_generation": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "format": {
      "const": "cd-worldline-policy-request/v1"
    },
    "policy": {
      "$ref": "worldline-policy-v1.schema.json"
    }
  },
  "additionalProperties": false
}
