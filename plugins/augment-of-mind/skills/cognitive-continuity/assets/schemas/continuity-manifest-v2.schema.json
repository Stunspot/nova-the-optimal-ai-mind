{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://collaborative-dynamics.com/schemas/cognitive-continuity/manifest-v2.json","title":"Cognitive Continuity Immutable Workspace Manifest v2","type":"object",
