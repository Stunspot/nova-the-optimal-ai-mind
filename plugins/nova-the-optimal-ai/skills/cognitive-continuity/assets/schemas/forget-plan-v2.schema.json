{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://collaborative-dynamics.com/schemas/cognitive-continuity/forget-plan-v2.json",
  "title":"Continuity Read-Only Forget Plan v2",
  "type":"object",
  "required":["format","id","created_at","expires_at","authority","workspace_id","workspace_format","compatibility_mode","source_manifest_sha256","source_tree_sha256","generation_before_plan","execute_generation","result_generation","apply_supported","required_action","blocking_reasons","mode","requested_ids","requested_ids_sha256","plan_digest","status","removed_ids","idempotency_identities","derivative_paths","counts","target_graph","target_graph_sha256","ambiguity","known_backups","known_export_receipts","backup_policy","target_sensitivity_classes","expected_outcomes","external_boundaries"],
  "properties":{
    "format":{"const":"cd-continuity-forget-plan/v2"},
    "id":{"type":"string"},
    "created_at":{"type":"string","format":"date-time"},
    "expires_at":{"type":"string","format":"date-time"},
    "authority":{"type":"string","minLength":1},
    "workspace_id":{"type":"string"},
    "workspace_format":{"enum":["cd-cognitive-continuity/v1","cd-cognitive-continuity/v2"]},
    "compatibility_mode":{"enum":["v1_read_only","v2_native"]},
    "source_manifest_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "source_tree_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "active_generation_manifest_sha256":{"type":["string","null"]},
    "generation_before_plan":{"type":"integer","minimum":0},
    "execute_generation":{"type":["integer","null"],"minimum":0},
    "result_generation":{"type":["integer","null"],"minimum":1},
    "apply_supported":{"type":"boolean"},
    "required_action":{"type":["string","null"]},
    "blocking_reasons":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "mode":{"enum":["tombstone","active-remove","physical-erase"]},
    "requested_ids":{"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},
    "requested_ids_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "plan_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "status":{"const":"planned"},
    "removed_ids":{"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},
    "idempotency_identities":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "derivative_paths":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "counts":{"type":"object"},
    "target_graph":{"type":"array","items":{"type":"object","required":["class","owner","disposition","proof"]}},
    "target_graph_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "ambiguity":{"type":"boolean"},
    "known_backups":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "known_export_receipts":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "backup_policy":{"type":"object","required":["required","custody","retention_until","destruction_owner","access_owner","encryption_disposition","restore_test"]},
    "target_sensitivity_classes":{"type":"array","items":{"enum":["ordinary","limited","sensitive","restricted"]},"uniqueItems":true},
    "expected_outcomes":{"type":"object"},
    "external_boundaries":{"type":"array","items":{"type":"string"},"uniqueItems":true}
  },
  "additionalProperties":false
}