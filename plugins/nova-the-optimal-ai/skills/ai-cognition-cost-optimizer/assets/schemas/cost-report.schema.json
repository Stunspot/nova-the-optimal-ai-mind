{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collaborative-dynamics.com/schemas/cognition-cost/cost-report-v1.json",
  "title": "AI Cognition Cost Report",
  "type": "object",
  "required": ["format", "route_id", "currency", "status", "components", "total_cost", "attempts", "accepted_outcomes", "eligible", "evidence"],
  "properties": {
    "format": {"const": "cd-cognition-cost-report/v1"},
    "route_id": {"type": "string"},
    "currency": {"type": "string"},
    "status": {"enum": ["complete", "incomplete"]},
    "components": {"type": "object", "additionalProperties": {"type": "number"}},
    "unknown_components": {"type": "array", "items": {"type": "string"}},
    "total_cost": {"type": "number", "minimum": 0},
    "attempts": {"type": "integer", "minimum": 1},
    "accepted_outcomes": {"type": "integer", "minimum": 0},
    "cost_per_attempt": {"type": "number", "minimum": 0},
    "cost_per_accepted_outcome": {"type": ["number", "null"], "minimum": 0},
    "waste_ratio": {"type": ["number", "null"], "minimum": 0},
    "cost_velocity_per_hour": {"type": ["number", "null"], "minimum": 0},
    "eligible": {"type": "boolean"},
    "floor_failures": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "object"}
  },
  "additionalProperties": false
}
