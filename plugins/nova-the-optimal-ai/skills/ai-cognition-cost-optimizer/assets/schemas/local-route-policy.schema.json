{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collaborative-dynamics.com/schemas/cognition-cost/local-route-policy-v1.json",
  "title": "Local Cognition Route Policy",
  "type": "object",
  "required": ["format", "id", "candidates"],
  "properties": {
    "format": {"const": "cd-local-route-policy/v1"},
    "id": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["model", "endpoint", "priority", "capabilities", "qualification"],
        "properties": {
          "model": {"type": "string", "minLength": 1},
          "endpoint": {"type": "string", "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\])(:[0-9]+)?/?$"},
          "enabled": {"type": "boolean"},
          "priority": {"type": "number", "minimum": 0},
          "estimated_cost_per_accepted_outcome": {"type": ["number", "null"], "minimum": 0},
          "capabilities": {
            "type": "object",
            "required": ["context_tokens", "modalities", "structured_output"],
            "properties": {
              "context_tokens": {"type": "integer", "minimum": 1},
              "modalities": {"type": "array", "items": {"type": "string"}},
              "structured_output": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          "qualification": {
            "type": "object",
            "required": ["status", "evaluated_task_classes", "evidence"],
            "properties": {
              "status": {"enum": ["qualified", "unverified", "failed", "expired"]},
              "evaluated_task_classes": {"type": "array", "items": {"type": "string"}},
              "acceptance_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "reliability_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "observed_p95_latency_ms": {"type": ["number", "null"], "minimum": 0},
              "evidence": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          },
          "think": {"type": "boolean"},
          "options": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
