{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collaborative-dynamics.com/schemas/cognition-cost/local-cognition-result-v1.json",
  "title": "Local Cognition Result",
  "type": "object",
  "required": ["format", "request_id", "request_sha256", "model", "endpoint", "executed_at", "response", "metrics", "workflow_run", "boundary"],
  "properties": {
    "format": {"const": "cd-local-cognition-result/v1"},
    "request_id": {"type": ["string", "null"]},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model": {"type": "string", "minLength": 1},
    "endpoint": {"type": "string", "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]+$"},
    "executed_at": {"type": "string", "minLength": 1},
    "response": {"type": ["string", "null"]},
    "done": {"type": ["boolean", "null"]},
    "done_reason": {"type": ["string", "null"]},
    "metrics": {"type": "object"},
    "workflow_run": {
      "type": "object",
      "required": ["format", "route_id", "attempts", "accepted_outcomes", "quantities", "assumptions"],
      "properties": {
        "format": {"const": "cd-cognition-workflow-run/v1"},
        "route_id": {"type": "string"},
        "attempts": {"const": 1},
        "accepted_outcomes": {"const": 0},
        "quantities": {"type": "object"},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
