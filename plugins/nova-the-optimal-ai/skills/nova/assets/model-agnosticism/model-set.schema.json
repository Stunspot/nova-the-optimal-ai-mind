{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collaborative-dynamics.com/schemas/model-agnosticism/model-set-v2.json",
  "title": "Epistemic Model Agnosticism model set v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "model_set_id",
    "revision",
    "case_ref",
    "question",
    "scope",
    "epistemic_lane",
    "observation_contract",
    "candidate_selection",
    "stopping_contract",
    "models",
    "comparison_contract",
    "reframe_policy",
    "provenance"
  ],
  "properties": {
    "contract": {
      "const": "cd-model-agnosticism-model-set/v2"
    },
    "model_set_id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "case_ref": {
      "$ref": "#/$defs/ref"
    },
    "question": {
      "$ref": "#/$defs/text"
    },
    "scope": {
      "$ref": "#/$defs/text"
    },
    "epistemic_lane": {
      "enum": [
        "evidence_update",
        "assumption_stress_test"
      ],
      "description": "Evidence updates may support model-relative belief only when every evidential gate passes. Assumption stress tests are conditional what-if calculations, never claim confidence."
    },
    "observation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoder_id",
        "encoder_version",
        "encoder_digest",
        "step_semantics",
        "step_contract",
        "ordering_rule",
        "missing_policy",
        "oov_policy",
        "symbols",
        "mapping_provenance"
      ],
      "properties": {
        "encoder_id": {
          "$ref": "#/$defs/id"
        },
        "encoder_version": {
          "$ref": "#/$defs/id"
        },
        "encoder_digest": {
          "$ref": "#/$defs/digest"
        },
        "step_semantics": {
          "$ref": "#/$defs/text"
        },
        "step_contract": {
          "$ref": "#/$defs/stepContract"
        },
        "ordering_rule": {
          "const": "event_time_strictly_ascending/v2"
        },
        "missing_policy": {
          "$ref": "#/$defs/text"
        },
        "oov_policy": {
          "const": "error"
        },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol_id",
              "definition",
              "coding_rule"
            ],
            "properties": {
              "symbol_id": {
                "$ref": "#/$defs/id"
              },
              "definition": {
                "$ref": "#/$defs/text"
              },
              "coding_rule": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "mapping_provenance": {
          "$ref": "#/$defs/inputProvenance"
        }
      }
    },
    "candidate_selection": {
      "$ref": "#/$defs/selectionContract"
    },
    "stopping_contract": {
      "$ref": "#/$defs/stoppingContract"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "comparison_unit_id",
          "label",
          "model_version",
          "family",
          "prior_model_weight",
          "prior_provenance",
          "state_order",
          "states",
          "initial",
          "transition",
          "emission",
          "matrix_layout",
          "assumptions",
          "parameter_basis",
          "parameter_provenance",
          "evidence_refs",
          "comparison_eligible"
        ],
        "properties": {
          "model_id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "model_version": {
            "$ref": "#/$defs/id"
          },
          "family": {
            "const": "discrete_first_order_hmm"
          },
          "prior_model_weight": {
            "description": "A declared prior must be strictly positive. Null means normalized between-model weights are unsupported.",
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "state_order": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state_id",
                "meaning"
              ],
              "properties": {
                "state_id": {
                  "$ref": "#/$defs/id"
                },
                "meaning": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          },
          "initial": {
            "$ref": "#/$defs/probabilityVector"
          },
          "transition": {
            "allOf": [
              {
                "$ref": "#/$defs/probabilityMatrix"
              }
            ],
            "description": "Rows follow source state_order; columns follow target state_order. Each row is stochastic."
          },
          "emission": {
            "allOf": [
              {
                "$ref": "#/$defs/probabilityMatrix"
              }
            ],
            "description": "Rows follow state_order; columns follow observation_contract.symbols order. Each row is stochastic."
          },
          "matrix_layout": {
            "$ref": "#/$defs/matrixLayout"
          },
          "assumptions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "markov_order",
              "output_independence",
              "one_observation_per_step",
              "stationarity_window"
            ],
            "properties": {
              "markov_order": {
                "type": "integer",
                "const": 1
              },
              "output_independence": {
                "$ref": "#/$defs/text"
              },
              "one_observation_per_step": {
                "$ref": "#/$defs/text"
              },
              "stationarity_window": {
                "$ref": "#/$defs/text"
              }
            }
          },
          "parameter_basis": {
            "$ref": "#/$defs/text"
          },
          "parameter_provenance": {
            "$ref": "#/$defs/inputProvenance"
          },
          "evidence_refs": {
            "$ref": "#/$defs/refs"
          },
          "comparison_eligible": {
            "type": "boolean"
          },
          "comparison_unit_id": {
            "$ref": "#/$defs/id"
          },
          "prior_provenance": {
            "$ref": "#/$defs/inputProvenance"
          }
        }
      }
    },
    "comparison_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "shared_observation_semantics_required",
        "shared_sequence_required",
        "prior_basis",
        "calibration_basis",
        "absolute_fit_policy"
      ],
      "properties": {
        "status": {
          "enum": [
            "eligible",
            "ineligible"
          ]
        },
        "shared_observation_semantics_required": {
          "type": "boolean"
        },
        "shared_sequence_required": {
          "type": "boolean"
        },
        "prior_basis": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "calibration_basis": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "absolute_fit_policy": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assessment_basis",
                "metric",
                "log_base",
                "unit",
                "threshold",
                "direction",
                "calibration_ref"
              ],
              "properties": {
                "metric": {
                  "const": "mean_predictive_surprisal"
                },
                "log_base": {
                  "const": "e"
                },
                "unit": {
                  "const": "nats_per_observation"
                },
                "threshold": {
                  "type": "number",
                  "minimum": 0
                },
                "direction": {
                  "const": "lte"
                },
                "calibration_ref": {
                  "$ref": "#/$defs/calibrationRef"
                },
                "assessment_basis": {
                  "const": "declared_threshold_arithmetic",
                  "description": "Fit is only arithmetic against a declared threshold; calibration truth is not validated by Trellis."
                }
              }
            }
          ]
        }
      }
    },
    "reframe_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_zero_likelihood",
        "all_absolute_fit_fail"
      ],
      "properties": {
        "all_zero_likelihood": {
          "const": "required"
        },
        "all_absolute_fit_fail": {
          "const": "required"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_by",
        "source_refs"
      ],
      "properties": {
        "created_by": {
          "$ref": "#/$defs/text"
        },
        "source_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "stepContract": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "interval_seconds",
            "description"
          ],
          "properties": {
            "kind": {
              "const": "event_step"
            },
            "interval_seconds": {
              "type": "null"
            },
            "description": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "interval_seconds",
            "description"
          ],
          "properties": {
            "kind": {
              "const": "fixed_interval"
            },
            "interval_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "description": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "selectionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis",
        "source_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "fixed_before_sequence",
            "data_dependent",
            "scenario_only"
          ]
        },
        "basis": {
          "$ref": "#/$defs/text"
        },
        "source_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "stoppingContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis",
        "maximum_observations"
      ],
      "properties": {
        "status": {
          "enum": [
            "fixed_before_sequence",
            "data_dependent",
            "scenario_only"
          ]
        },
        "basis": {
          "$ref": "#/$defs/text"
        },
        "maximum_observations": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "matrixLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition",
        "emission"
      ],
      "properties": {
        "transition": {
          "const": "source_state_rows_target_state_columns/v1"
        },
        "emission": {
          "const": "state_rows_symbol_columns/v1"
        }
      }
    },
    "parameterProvenance": {
      "$ref": "#/$defs/inputProvenance"
    },
    "probabilityVector": {
      "description": "Runtime requires a sum within 1e-9 of one, then L1-normalizes and discloses any adjustment. Exact zero is only a supplied-model support exclusion, never real-world impossibility.",
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "probabilityMatrix": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/probabilityVector"
      }
    },
    "calibrationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration_id",
        "revision",
        "digest",
        "calibration_target_digest",
        "minimum_observations",
        "maximum_observations",
        "provenance"
      ],
      "properties": {
        "calibration_id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "calibration_target_digest": {
          "$ref": "#/$defs/digest",
          "description": "Noncircular digest binding the declared calibration to the exact candidate HMM family, ordered kernels, comparison units, observation contract, stopping regime, and horizon bounds."
        },
        "minimum_observations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maximum_observations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "provenance": {
          "$ref": "#/$defs/inputProvenance"
        }
      }
    },
    "inputProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fixed_before_sequence",
        "basis",
        "source_refs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "estimated_independent_data",
            "expert_elicited",
            "stipulated_scenario"
          ]
        },
        "fixed_before_sequence": {
          "type": "boolean"
        },
        "basis": {
          "$ref": "#/$defs/text"
        },
        "source_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    }
  }
}
