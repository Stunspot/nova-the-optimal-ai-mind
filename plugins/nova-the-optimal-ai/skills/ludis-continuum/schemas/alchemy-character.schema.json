{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collaborativedynamics.net/schemas/alchemy-character-unversioned.schema.json",
  "title": "Alchemy Character JSON conservative interoperability profile",
  "description": "A structural profile derived from Alchemy's unversioned official Character JSON documentation and examples. It does not prove live import compatibility.",
  "type": "object",
  "required": [
    "name",
    "systemKey"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "systemKey": {
      "type": "string",
      "minLength": 1
    },
    "isNPC": {
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "appearance": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "typeTags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "race": {
      "type": "string"
    },
    "abilityScores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "currentHp": {
      "type": "number"
    },
    "maxHp": {
      "type": "number"
    },
    "armorClass": {
      "type": "number"
    },
    "movementModes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mode",
          "distance"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "minLength": 1
          },
          "distance": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "textBlocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/textBlockGroup"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "steps"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "sortOrder": {
            "type": "number"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {"type": "string", "minLength": 1}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "imageUri": {
      "type": "string",
      "minLength": 1
    },
    "spells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "textBlockGroup": {
      "type": "object",
      "required": [
        "title",
        "textBlocks"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "textBlocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "body"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}