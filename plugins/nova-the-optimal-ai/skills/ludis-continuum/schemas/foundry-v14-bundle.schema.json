{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collaborativedynamics.net/schemas/foundry-v14-bundle.schema.json",
  "title": "Ludis Foundry VTT generation 14 bundle payload",
  "description": "Static Ludis bundle contract for Foundry 14.365 core JournalEntry, RollTable, Scene, and embedded Level data. It does not establish live import compatibility.",
  "type": "object",
  "required": [
    "format",
    "audience",
    "target",
    "compatibility",
    "module",
    "pack",
    "source",
    "documents",
    "assets"
  ],
  "properties": {
    "format": {
      "const": "cd-ludis-foundry-v14/v1"
    },
    "audience": {
      "enum": ["gm", "player"]
    },
    "target": {
      "type": "object",
      "required": [
        "generation",
        "build"
      ],
      "properties": {
        "generation": {
          "const": 14
        },
        "build": {
          "const": 365
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": [
        "state",
        "liveImportVerified"
      ],
      "properties": {
        "state": {
          "const": "statically_ready"
        },
        "liveImportVerified": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "pack": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "projectionSha256"
      ],
      "properties": {
        "projectionSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "documents": {
      "type": "object",
      "required": [
        "JournalEntry",
        "RollTable",
        "Scene"
      ],
      "properties": {
        "JournalEntry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/journal"
          }
        },
        "RollTable": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rollTable"
          }
        },
        "Scene": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sceneImport"
          }
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceId",
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^assets/(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ownership": {
      "type": "object",
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "type": "integer",
          "enum": [0, 2]
        }
      },
      "additionalProperties": false
    },
    "flags": {
      "type": "object",
      "required": [
        "ludis"
      ],
      "properties": {
        "ludis": {
          "type": "object",
          "required": [
            "sourceId",
            "campaignId",
            "audience",
            "importRevisionSha256"
          ],
          "properties": {
            "sourceId": {
              "type": "string",
              "minLength": 1
            },
            "campaignId": {
              "type": "string",
              "minLength": 1
            },
            "audience": {
              "enum": ["gm", "player"]
            },
            "importRevisionSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "journal": {
      "type": "object",
      "required": [
        "name",
        "ownership",
        "flags",
        "pages"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "flags": {
          "$ref": "#/$defs/flags"
        },
        "pages": {
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "rollTable": {
      "type": "object",
      "required": [
        "name",
        "formula",
        "ownership",
        "flags",
        "results"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "formula": {
          "type": "string",
          "pattern": "^1d[1-9][0-9]*$"
        },
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "flags": {
          "$ref": "#/$defs/flags"
        },
        "results": {
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "level": {
      "type": "object",
      "required": [
        "name",
        "background",
        "flags"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "background": {
          "type": "object",
          "required": [
            "src"
          ],
          "properties": {
            "src": {
              "type": "string",
              "pattern": "^modules/[a-z0-9][a-z0-9-]*/assets/.+$"
            }
          },
          "additionalProperties": true
        },
        "flags": {
          "$ref": "#/$defs/flags"
        }
      },
      "additionalProperties": true
    },
    "sceneImport": {
      "type": "object",
      "required": [
        "sourceId",
        "scene",
        "levels",
        "initialLevelSourceId"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "scene": {
          "type": "object",
          "required": [
            "name",
            "width",
            "height",
            "ownership",
            "flags"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "ownership": {
              "$ref": "#/$defs/ownership"
            },
            "flags": {
              "$ref": "#/$defs/flags"
            }
          },
          "not": {
            "required": [
              "background"
            ]
          },
          "additionalProperties": true
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/level"
          }
        },
        "initialLevelSourceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}