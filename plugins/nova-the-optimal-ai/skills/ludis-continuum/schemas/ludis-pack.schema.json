{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collaborativedynamics.net/schemas/ludis-pack-v1.schema.json",
  "title": "Ludis Pack v1",
  "type": "object",
  "required": ["format", "audience", "campaign", "source", "object_ids", "asset_ids", "adapter", "human_review_required", "members"],
  "properties": {
    "format": {"const": "cd-ludis-pack/v1"},
    "audience": {"enum": ["gm", "player"]},
    "campaign": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "title": {"type": "string"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["capture_digest", "ledger_sha256"],
      "properties": {
        "capture_digest": {"$ref": "#/$defs/sha256"},
        "ledger_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "object_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "asset_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "adapter": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {"id": {"type": "string"}, "version": {"type": "string"}},
      "additionalProperties": true
    },
    "human_review_required": {"type": "boolean"},
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "manifest_self_hash": {"type": "string"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}