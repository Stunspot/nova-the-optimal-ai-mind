# CD line-ending policy: LF for authored text; explicit exceptions below.
* text=auto eol=lf

# Windows-native text exceptions.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary containers and media.
*.zip binary
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Binary containers and media.
*.webp binary
*.mp4 binary

# Source-locked imported skill closures retain their exact upstream bytes.
plugins/nova-the-optimal-ai/skills/** -text

# Retained Hesperos evidence is hash-bound, including native execution logs.
verification/giles-atlas-3.6/hesperos/evidence/** -text

# Current complete native plugin bytes remain source-locked on checkout.
/plugins/nova-the-optimal-ai/** -text

# Qualified Claude host closure is byte-preserved as well.
/claude/nova-the-optimal-ai/** -text
/documentation-source/** -text
/verification/hesperos-capabilities/** -text

# Source map and lock bind accepted raw bytes, including existing line endings.
/design/source-map.json -text
/design/source-lock.json -text

# Hash-bound current authoring evidence retains exact source bytes.
/delivery-wrapper/documentation-source/** -text
/delivery-wrapper/verification/hesperos-capabilities/** -text
/documentation-manifest.json -text
/delivery-wrapper/documentation-manifest.json -text
