{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collaborative-dynamics.com/privacy-redline/privacy-case.schema.json",
  "title": "Privacy Redline Case",
  "type": "object",
  "required": ["format", "case_id", "title", "status", "purpose", "pressure", "map", "ledger", "queue", "receipts", "logbook", "triggers", "last_safe_checkpoint", "updated_at"],
  "properties": {
    "format": {"const": "privacy-redline/case-v1"},
    "case_id": {"type": "string", "minLength": 3},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["intake", "stabilized", "mapped", "active", "review", "maintained", "escalated", "paused-safe"]},
    "purpose": {"type": "string"},
    "jurisdiction": {"type": "object"},
    "pressure": {
      "type": "object",
      "required": ["state", "immediate_danger_screened", "safe_channel_confirmed"],
      "properties": {
        "state": {"enum": ["preventive", "recent", "live", "unknown"]},
        "immediate_danger_screened": {"type": "boolean"},
        "safe_channel_confirmed": {"type": "boolean"}
      }
    },
    "map": {"type": "object"},
    "ledger": {"type": "object"},
    "queue": {"type": "array"},
    "receipts": {"type": "array"},
    "logbook": {"type": "array"},
    "triggers": {"type": "array"},
    "last_safe_checkpoint": {"type": "string"},
    "updated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  },
  "additionalProperties": true
}

